# Telegram API credentials -> https://my.telegram.org/apps
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_SESSION=tgscraper            # session file name (no extension)
TG_PHONE=+15551234567           # optional, prompts on first login

# Channel: @username, https://t.me/name, https://t.me/c/123456/1 or numeric id
TG_CHANNEL=@some_prompt_channel

# Google Drive
# OAuth desktop client json (default) OR service account json
GOOGLE_CREDENTIALS=credentials.json
GOOGLE_TOKEN=token.json
GOOGLE_AUTH_MODE=oauth          # oauth | service_account
# Destination path inside Drive, created if missing.
# Prefix with "My Drive/" or a Shared Drive name, or pass a folder ID.
DRIVE_PATH=My Drive/Prompts/TelegramChannel
DRIVE_FOLDER_ID=                # optional, overrides DRIVE_PATH
